# Compose image selection
GHCR_OWNER=recycle385
IMAGE_TAG=replace-with-git-sha

# Public service URL and TLS
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
CLIENT_URL=https://example.com
BACKEND_URL=https://example.com
GOACCESS_REFRESH_SECONDS=300
TRAFFIC_DASHBOARD_PATH=replace-with-private-path/traffic

# Application
PORT=3000
NODE_ENV=production
MAIN_JWT_SECRET=replace-with-at-least-32-random-characters
PARTICIPANT_JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
SIGNUP_MODE=immediate
ENABLE_RATE_LIMIT=true
GENERAL_RATE_LIMIT_MAX=600
HOST_ACCESS_TOKEN=

# Database
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_HOST=db
DB_PORT=3306
DB_USER=calendar_user
DB_USER_PASSWORD=replace-with-a-strong-user-password
DB_NAME=calendar_db
DB_CONNECTION_LIMIT=10

# Redis
REDIS_URL=redis://redis:6379

# External APIs - Google login
GOOGLE_CLIENT_ID=replace-with-google-login-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-login-client-secret

# External APIs - Gmail sender
GMAIL_CLIENT_ID=replace-with-gmail-sender-client-id
GMAIL_CLIENT_SECRET=replace-with-gmail-sender-client-secret
GMAIL_REFRESH_TOKEN=replace-with-oauth-playground-refresh-token
GMAIL_SENDER_EMAIL=replace-with-sender@gmail.com

# External APIs - Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=replace-with-groq-model

# External APIs - Public data
GET_REST_DE_INFO=replace-with-data-go-kr-service-key
